# Copy to .env (gitignored). The API (node --env-file) and Vite both read the root .env;
# variables already set in the process environment take precedence.

# Database (only pharmacy_* tables are used)
DATABASE_URL=postgresql://user:password@host:5432/db

# API server
PORT=8080
AUTH_MODE=local
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
LOG_LEVEL=info

# Sign-up: "Google bilan kirish" (Google Cloud Console → OAuth client, type "Web application").
# Authorized redirect URI: <site address>/api/auth/google/callback, e.g. http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: fixed callback / public address when the app sits behind a tunnel or proxy
GOOGLE_REDIRECT_URI=https://pharmxs.uz/api/auth/google/callback
PUBLIC_APP_URL=https://pharmxs.uz

# Platform owner console (separate from public domain — VPS IP + dedicated port)
LISTEN_HOST=127.0.0.1
OWNER_HOSTS=138.249.7.30
OWNER_PUBLIC_URL=http://138.249.7.30:9080

# Platform owner (no company org). Matching Google/email signup becomes platform_admin.
PLATFORM_ADMIN_EMAIL=

# Click Shop API (HTTPS callbacks only)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# Enterprise Telegram bot (optional)
TELEGRAM_BOT_TOKEN=

# Sign-up: 6-character email codes over SMTP (Gmail: enable 2-Step Verification, then create an App Password)
# Without SMTP (and NODE_ENV != production) codes are only written to the API log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=PHARMXS
# Optional: who gets an email about each new sign-up request
ADMIN_NOTIFY_EMAIL=

# Web (Vite); only VITE_* values reach the browser
WEB_PORT=5173
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8080
VITE_AUTH_MODE=local

# FOM / F-APTEKA — pharmacy PC PowerShell pulls locally, posts to VPS (no VPN)
FOM_WINDOW_DAYS=7
FOM_START_DATE=2025-01-01
FOM_SYNC_INTERVAL_MIN=0
FOM_REFS_INTERVAL_MIN=60
FOM_INITIAL_DAYS=680
FOM_TIMEOUT_MS=180000
FOM_OPS_TOKEN=
