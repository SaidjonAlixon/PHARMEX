# Copy to .env (gitignored). The API (node --env-file) and Vite both read the root .env;
# variables already set in the process environment take precedence.

# Database (only pharmacy_* tables are used)
DATABASE_URL=postgresql://user:password@host:5432/db

# API server
PORT=8080
AUTH_MODE=local
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
LOG_LEVEL=info

# Sign-up: "Google bilan kirish" (Google Cloud Console → OAuth client, type "Web application").
# Authorized redirect URI: <site address>/api/auth/google/callback, e.g. http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: fixed callback / public address when the app sits behind a tunnel or proxy
GOOGLE_REDIRECT_URI=
PUBLIC_APP_URL=

# Sign-up: 6-character email codes over SMTP (Gmail: enable 2-Step Verification, then create an App Password)
# Without SMTP (and NODE_ENV != production) codes are only written to the API log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=PHARMEX
# Optional: who gets an email about each new sign-up request
ADMIN_NOTIFY_EMAIL=

# Web (Vite); only VITE_* values reach the browser
WEB_PORT=5173
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8080
VITE_AUTH_MODE=local

# FOM GROUP / F-APTEKA — REPORT.exe (P_GetReport_XML), pulled by the server
FOM_REPORT_URL=http://26.66.205.88:8084
# Or call dbo.P_GetReport_XML on the pharmacy SQL Server directly (takes precedence over FOM_REPORT_URL).
# Pharmacy public IP + router port forwarded to SQL Server 1433. Use a read-only login, never sa.
FOM_SQL_HOST=
FOM_SQL_PORT=1433
FOM_SQL_DATABASE=NGLOBAL
FOM_SQL_USER=
FOM_SQL_PASSWORD=
# TLS to SQL Server (default on); set false only for very old servers without TLS 1.2
FOM_SQL_ENCRYPT=true
# Branch name when the FOM version has no organisations report (189)
FOM_BRANCH_NAME=
# Extra pFilial_id values; the rest are discovered (orgs with APT=1, stock O values, known FOM branches)
FOM_FILIAL_IDS=1
# Documents + stock every N minutes, reference books every M minutes (0 = no auto sync)
FOM_SYNC_INTERVAL_MIN=5
FOM_REFS_INTERVAL_MIN=60
# Optional sub-minute polling (overrides the minutes above); stock is then refreshed every FOM_STOCK_INTERVAL_MIN
# FOM_SYNC_INTERVAL_SEC=15
# FOM_STOCK_INTERVAL_MIN=5
# F-APTEKA receipt times are local wall-clock time
# FOM_TZ=+05:00
FOM_INITIAL_DAYS=365
FOM_TIMEOUT_MS=120000

# FOM GROUP / F-APTEKA — SITE.exe pushes stock XML to POST /api/fom/site/<FOM_SITE_TOKEN>
FOM_SITE_TOKEN=
